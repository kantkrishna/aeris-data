# .env
# AERIS Live Environment Secrets (Ignored in Git)

# Snowflake Live Credentials
SNOWFLAKE_ACCOUNT="your_account_identifier" # e.g., xy12345.us-east-2.aws
SNOWFLAKE_USER="your_username"
SNOWFLAKE_PASS="your_secure_password"
SNOWFLAKE_WH="your_active_warehouse"
SNOWFLAKE_DB="your_sandbox_database"

# Databricks (Leave blank to safely skip Databricks integration tests)
DATABRICKS_HOST=""
DATABRICKS_TOKEN=""
DATABRICKS_TEST_JOB_ID=""